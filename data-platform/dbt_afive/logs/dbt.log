        adj_close::numeric(14, 4) as adj_close,
        volume::bigint as volume,
        coalesce(dividend_amount::numeric(14, 4), 0.0) as dividend_amount,
        -- Rows ingested before the extractor fix carry Yahoo's 0.0 "no split" marker
