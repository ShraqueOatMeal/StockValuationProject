from "afive_dw"."bronze"."raw_yf_fundamentals"
group by 2

union all

select
    'sec_edgar' as source,
    upper(trim(ticker)) as ticker,
    count(*) as row_count,
    null::date as latest_data_date,
    max(ingested_at) as last_ingested_at,
    current_timestamp as checked_at
from "afive_dw"."bronze"."raw_sec_filings"
group by 2
  );
  
