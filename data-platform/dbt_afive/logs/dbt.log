from "afive_dw"."gold"."fact_daily_market_valuation" v
join "afive_dw"."gold"."dim_company" c on v.company_sk = c.company_sk
where v.trade_date = (select max(trade_date) from "afive_dw"."gold"."fact_daily_market_valuation")
group by c.industry
  );
  
