  create  table "afive_dw"."gold"."fact_quarterly_financials__dbt_tmp"
  
  
    as
  
  (
    with scd2_current as (
    select *
    from "afive_dw"."silver"."silver_financial_statements_scd2"
    where is_current = true
),

normalized_periods as (
    select
        ticker,
        cik,
        accession_number,
        form_type,
        gaap_tag,
        amount,
        period_start_date,
        period_end_date,
        valid_from as filing_date,

        -- 1. Fix Fiscal Year Leakage: If filing header year is ahead of the period end date,
        -- normalize year and quarter to the actual calendar filing date.
        extract(year from period_end_date)::int as calendar_year,
        'Q' || extract(quarter from period_end_date)::text as calendar_quarter,

        -- Calculate duration in days (NULL for balance sheet instants)
        case
            when period_start_date is not null
            then (period_end_date - period_start_date)
            else null
        end as duration_days
    from scd2_current
),

-- Aggregate filings by calendar quarter and tag
quarterly_aggregates as (
    select
        ticker,
        cik,
        calendar_year as fiscal_year,
        calendar_quarter as fiscal_period,
        max(period_end_date) as period_end_date,
        min(filing_date) as filing_date,
        min(accession_number) as accession_number,

        -- 1. Discrete 3-Month Flows (65 to 105 days)
        max(case 
            when gaap_tag in ('Revenues', 'SalesRevenueNet', 'RevenueFromContractWithCustomerExcludingAssessedTax', 'SalesRevenueServicesNet')
             and duration_days between 65 and 105 then amount 
        end) as discrete_revenue,

        max(case 
            when gaap_tag = 'OperatingIncomeLoss' and duration_days between 65 and 105 then amount 
        end) as discrete_operating_income,

        max(case 
            when gaap_tag = 'NetIncomeLoss' and duration_days between 65 and 105 then amount 
        end) as discrete_net_income,

        max(case 
            when gaap_tag = 'NetCashProvidedByUsedInOperatingActivities' and duration_days between 65 and 105 then amount 
        end) as discrete_cfo,

        max(case 
            when gaap_tag = 'PaymentsToAcquirePropertyPlantAndEquipment' and duration_days between 65 and 105 then amount 
        end) as discrete_capex,

        -- 2. Cumulative / Full-Year Flows
        max(case 
            when gaap_tag in ('Revenues', 'SalesRevenueNet', 'RevenueFromContractWithCustomerExcludingAssessedTax', 'SalesRevenueServicesNet')
            then amount 
        end) as max_reported_revenue,

        max(case when gaap_tag = 'OperatingIncomeLoss' then amount end) as max_reported_operating_income,
        max(case when gaap_tag = 'NetIncomeLoss' then amount end) as max_reported_net_income,
        max(case when gaap_tag = 'NetCashProvidedByUsedInOperatingActivities' then amount end) as max_reported_cfo,
        max(case when gaap_tag = 'PaymentsToAcquirePropertyPlantAndEquipment' then amount end) as max_reported_capex,

        -- 3. Balance Sheet & Shares (Instant values)
        max(case when gaap_tag = 'Assets' then amount end) as total_assets,
        max(case when gaap_tag = 'AssetsCurrent' then amount end) as current_assets,
        max(case when gaap_tag = 'Liabilities' then amount end) as total_liabilities,
        max(case when gaap_tag = 'LiabilitiesCurrent' then amount end) as current_liabilities,
        max(case when gaap_tag = 'StockholdersEquity' then amount end) as stockholders_equity,
        max(case when gaap_tag = 'CashAndCashEquivalentsAtCarryingValue' then amount end) as cash_and_cash_equivalents,
        max(case when gaap_tag in ('EntityCommonStockSharesOutstanding', 'CommonStockSharesOutstanding', 'WeightedAverageNumberOfDilutedSharesOutstanding') then amount end) as shares_outstanding
    from normalized_periods
    group by ticker, cik, calendar_year, calendar_quarter
),

-- Standardize to discrete flows
discrete_financials as (
    select
        q.ticker,
        q.cik,
        q.fiscal_year,
        q.fiscal_period,
        q.period_end_date,
        q.filing_date,
        q.accession_number,
        q.total_assets,
        q.current_assets,
        q.total_liabilities,
        q.current_liabilities,
        q.stockholders_equity,
        q.cash_and_cash_equivalents,
        q.shares_outstanding,

        -- Revenue: prioritize discrete; fallback to subtracting YTD / running sums
        coalesce(
            q.discrete_revenue,
            case
                when q.fiscal_period in ('Q2', 'Q3') and q.max_reported_revenue > lag(q.max_reported_revenue) over w_fy
                then q.max_reported_revenue - lag(q.max_reported_revenue) over w_fy
                when q.fiscal_period = 'Q4' and q.max_reported_revenue > sum(coalesce(q.discrete_revenue, 0)) over w_preceding_qtrs
                then q.max_reported_revenue - sum(coalesce(q.discrete_revenue, 0)) over w_preceding_qtrs
                else q.max_reported_revenue
            end
        ) as total_revenue,

        -- Operating Income: prioritize discrete; fallback to YTD subtraction
        coalesce(
            q.discrete_operating_income,
            case
                when q.fiscal_period in ('Q2', 'Q3') and q.max_reported_operating_income > lag(q.max_reported_operating_income) over w_fy
                then q.max_reported_operating_income - lag(q.max_reported_operating_income) over w_fy
                when q.fiscal_period = 'Q4' and q.max_reported_operating_income > sum(coalesce(q.discrete_operating_income, 0)) over w_preceding_qtrs
                then q.max_reported_operating_income - sum(coalesce(q.discrete_operating_income, 0)) over w_preceding_qtrs
                else q.max_reported_operating_income
            end
        ) as operating_income,

        -- Net Income: prioritize discrete; fallback to YTD subtraction
        coalesce(
            q.discrete_net_income,
            case
                when q.fiscal_period in ('Q2', 'Q3') and q.max_reported_net_income > lag(q.max_reported_net_income) over w_fy
                then q.max_reported_net_income - lag(q.max_reported_net_income) over w_fy
                when q.fiscal_period = 'Q4' and q.max_reported_net_income > sum(coalesce(q.discrete_net_income, 0)) over w_preceding_qtrs
                then q.max_reported_net_income - sum(coalesce(q.discrete_net_income, 0)) over w_preceding_qtrs
                else q.max_reported_net_income
            end
        ) as net_income,

        -- Operating Cash Flow
        coalesce(
            q.discrete_cfo,
            case
                when q.fiscal_period in ('Q2', 'Q3', 'Q4') and q.max_reported_cfo > lag(q.max_reported_cfo) over w_fy
                then q.max_reported_cfo - lag(q.max_reported_cfo) over w_fy
                else q.max_reported_cfo
            end
        ) as operating_cash_flow,

        -- CapEx
        coalesce(
            q.discrete_capex,
            case
                when q.fiscal_period in ('Q2', 'Q3', 'Q4') and q.max_reported_capex > lag(q.max_reported_capex) over w_fy
                then q.max_reported_capex - lag(q.max_reported_capex) over w_fy
                else q.max_reported_capex
            end
        ) as capital_expenditures
    from quarterly_aggregates q
    window 
        w_fy as (
            partition by q.ticker, q.fiscal_year 
            order by q.period_end_date
        ),
        w_preceding_qtrs as (
            partition by q.ticker, q.fiscal_year 
            order by q.period_end_date 
            rows between unbounded preceding and 1 preceding
        )
),

ratios as (
  select
    -- Surrogate Key
    md5(concat_ws('||', ticker, fiscal_year, fiscal_period)) as financial_sk,
    md5(ticker) as company_sk,
    ticker,
    fiscal_year,
    fiscal_period,
    period_end_date,
    filing_date,
    accession_number,
    total_revenue,
    operating_income,
    net_income,
    total_assets,
    current_assets,
    total_liabilities,
    current_liabilities,
    stockholders_equity,
    cash_and_cash_equivalents,
    operating_cash_flow,
    capital_expenditures,
    shares_outstanding,

    -- Derived Free Cash Flow
    (coalesce(operating_cash_flow, 0) - coalesce(capital_expenditures, 0)) as free_cash_flow,

    -- Financial Margins & Returns
    round(operating_income / nullif(total_revenue, 0), 4) as operating_margin,
    round(net_income / nullif(total_revenue, 0), 4) as net_margin,
    round(net_income / nullif(stockholders_equity, 0), 4) as return_on_equity,
    round(total_liabilities / nullif(stockholders_equity, 0), 4) as debt_to_equity,
    round(current_assets / nullif(current_liabilities, 0), 4) as current_ratio,
    current_timestamp as computed_at
  from discrete_financials
),

with_ttm as (
  select
    r.*,

    -- 4-Quarter Rolling TTM sums
    sum(total_revenue) over w_ttm as ttm_revenue,
    sum(operating_income) over w_ttm as ttm_operating_income,
    sum(net_income) over w_ttm as ttm_net_income,
    sum(free_cash_flow) over w_ttm as ttm_fcf,
    sum(operating_cash_flow) over w_ttm as ttm_operating_cash_flow,

    -- YoY Quarter Comparison (same quarter 1 year ago)
    lag(total_revenue, 4) over w_ticker as prev_year_revenue,
    round(
      ((total_revenue - lag(total_revenue, 4) over w_ticker) / nullif(lag(total_revenue, 4) over w_ticker, 0)) * 100,
      2
    ) as revenue_yoy_growth
  from ratios r
  window
    w_ttm as (
      partition by ticker
      order by period_end_date
      rows between 3 preceding and current row
    ),
    w_ticker as (
      partition by ticker
      order by period_end_date
    )
)

select * from with_ttm
  );
  
